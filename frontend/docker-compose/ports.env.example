# Canonical host-port defaults for shared compose fragments.
# Copy keys into a case docker-compose/.env as needed.

# Frontend (infini-loadbalancer) — at most one publisher per host
ROUTER_PORT=8800
FRONTEND_HOST_PORT=8800
# Optional legacy registry port alias → Frontend
# REGISTRY_PORT=18000

# etcd — leave unset to keep compose-internal only
# ETCD_HOST_PORT=2379
ETCD_IMAGE_TAG=quay.io/coreos/etcd:v3.7.0
ETCD_NAME=infiniorch-etcd
ETCD_CLUSTER_TOKEN=infiniorch-etcd

# Observability — one Prom/Grafana stack per host
PROM_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus scrape target (compose DNS or host gateway)
# Default matches Frontend service + ROUTER_PORT
OBS_SCRAPE_TARGET=frontend:8800
# Host Frontend already up (obs-only):
# OBS_SCRAPE_TARGET=host.docker.internal:8800
# PROM_CONFIG=prometheus-host.yml

# Bench warehouse (frontend.yml mounts bench_warehouse:/warehouse:ro)
# Enable: ./compose.sh --profile frontend --profile warehouse-sync up -d
# BENCH_WAREHOUSE_GITHUB_TOKEN=ghp_xxx
# BENCH_WAREHOUSE_GIT_URL=https://github.com/InfiniTensor/bench-warehouse.git
# BENCH_WAREHOUSE_GIT_REF=master
# BENCH_WAREHOUSE_SYNC_INTERVAL_SEC=300
