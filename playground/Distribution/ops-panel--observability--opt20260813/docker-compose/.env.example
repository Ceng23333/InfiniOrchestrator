# Orchestrator image that includes infini-loadbalancer (Frontend + /panel).
IMAGE_TAG=infini-orchestrator-metax:4e0fdd7e-6ad5e1c9-20260812
ETCD_IMAGE_TAG=quay.io/coreos/etcd:v3.7.0
ETCD_NAME=ops-panel-etcd
ETCD_CLUSTER_TOKEN=ops-panel-opt-20260813
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.0

ROUTER_PORT=8800
FRONTEND_HOST_PORT=8800
# Avoid clashing with inference case REGISTRY_PORT=18000 when both stacks exist
REGISTRY_PORT=18800
PROM_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

DISCOVERY_PREFIX=/infini/orchestrator/ops-panel
BENCH_WAREHOUSE_HOST_PATH=../../../../../bench-warehouse

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Obs-only against host Frontend: PROM_CONFIG=prometheus-host.yml
# PROM_CONFIG=prometheus.yml
