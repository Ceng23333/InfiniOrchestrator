## Workers host — opt20260811 (Dynamo Workers only; no Frontend on this host)
## Copy: cp .env.workers.example .env
## Replace <FRONTEND_HOST> and <WORKER_HOST> with LAN IPs (not 127.0.0.1).
##
## Bring-up (separate compose project from Frontend):
##   COMPOSE_PROJECT_NAME=io-workers ./compose.sh --profile workers up -d
##
## Frontend host must already publish ROUTER_PORT / REGISTRY_PORT / etcd :2379.

IMAGE_TAG=infini-orchestrator-metax:PLACEHOLDER-PLACEHOLDER-YYYYMMDD
# Emergency rollback only (not required): pin embeddings to a TF4.51 image
# EMBEDDING_IMAGE_TAG=infini-orchestrator-metax:9647f70-b81c5860-20260701

FRONTEND_HOST=<FRONTEND_HOST>
ADVERTISE_HOST=<WORKER_HOST>

REGISTRY_PORT=18000
ROUTER_PORT=8800
# When ADVERTISE_HOST is a LAN IP, host publish ports must equal container ports.
EMBEDDING_PORT=20002
EMBEDDING_BABYSITTER_PORT=20003

ROUTER_URL=http://<FRONTEND_HOST>:8800
REGISTRY_URL=http://<FRONTEND_HOST>:18000
ETCD_ENDPOINTS=http://<FRONTEND_HOST>:2379

WORKER_9G_API_PORT=8100
WORKER_9G_BABYSITTER_PORT=8101
WORKER_QWEN_API_PORT=8200
WORKER_QWEN_BABYSITTER_PORT=8201

MODEL1_DIR=/data-aisoft/zenghua/models/9g_8b_thinking_llama
QWEN3_32B_DIR=/data-aisoft/zenghua/models/Qwen3-32B
EMBEDDING_MODEL_DIR=/data-aisoft/zenghua/models/embedding-models
PIECEWISE_INDUCTOR_CACHE_DIR=../cache/piecewise_inductor
