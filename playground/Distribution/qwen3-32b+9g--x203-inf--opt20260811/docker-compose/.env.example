## InfiniOrchestrator case: infinilm-metax-deployment-opt-20260811
## Master-only InfiniLM stack (9g + Qwen-paged + embeddings). No XiYan slave. No vLLM backends.
##
##   cd docker-compose
##   cp .env.example .env && edit model paths + IMAGE_TAG
##   Prefer .env.master.example for the same master-only layout.
##   IMAGE_TAG from: cat ../image/.image_tag
##

IMAGE_TAG=infini-orchestrator-metax:PLACEHOLDER-PLACEHOLDER-YYYYMMDD
# Dedicated discovery plane
# ETCD_IMAGE_TAG=quay.io/coreos/etcd:v3.7.0
# Optional: pin embeddings to 0611-era image (transformers 4.51) if IMAGE_TAG is TF5
# EMBEDDING_IMAGE_TAG=infini-orchestrator-metax:9647f70-b81c5860-20260701

REGISTRY_PORT=18000
ROUTER_PORT=8800
EMBEDDING_PORT=20003

CACHE_TYPE_ROUTING_THRESHOLD=51200

MASTER_9G_8B_THINKING_API_PORT=8102
MASTER_9G_8B_THINKING_BABYSITTER_PORT=8103
MASTER_QWEN_PAGED_API_PORT=8200
MASTER_QWEN_PAGED_BABYSITTER_PORT=8201

MODEL1_DIR=/data-aisoft/zenghua/models/9g_8b_thinking_llama
QWEN3_32B_DIR=/data-aisoft/zenghua/models/Qwen3-32B
EMBEDDING_MODEL_DIR=/data-aisoft/zenghua/models/embedding-models
PIECEWISE_INDUCTOR_CACHE_DIR=../cache/piecewise_inductor

# Bench warehouse: owned by frontend fragments (named volume bench_warehouse).
# Enable sync for LongBench viz (token required for private HTTPS):
#   ./compose.sh --profile frontend --profile warehouse-sync up -d
# Without sync, /warehouse may be empty — use host panel (frontend/run-host-panel.sh) offline.
# BENCH_WAREHOUSE_GITHUB_TOKEN=ghp_xxx
# BENCH_WAREHOUSE_GIT_URL=https://github.com/InfiniTensor/bench-warehouse.git
# BENCH_WAREHOUSE_GIT_REF=master
# BENCH_WAREHOUSE_SYNC_INTERVAL_SEC=300
