## Same-host / Frontend host — opt20260811 (Dynamo Frontend + Workers)
## Copy: cp .env.example .env
## Prefer .env.frontend.example (identical layout). IMAGE_TAG from: cat ../image/.image_tag
##
## Bring-up:
##   ./compose.sh --profile frontend --profile workers up -d
## Multi-host workers: see .env.workers.example
## Localhost fake multi-node: see .env.workers-sim.example + simulate_multinode_localhost.sh

IMAGE_TAG=infini-orchestrator-metax:PLACEHOLDER-PLACEHOLDER-YYYYMMDD
# ETCD_IMAGE_TAG=quay.io/coreos/etcd:v3.7.0
# Emergency rollback only (not required): pin embeddings to a TF4.51 image
# EMBEDDING_IMAGE_TAG=infini-orchestrator-metax:9647f70-b81c5860-20260701

REGISTRY_PORT=18000
ROUTER_PORT=8800
FRONTEND_HOST_PORT=8800
# Embeddings API (container :20002) + entrypoint/metadata (container :20003)
EMBEDDING_PORT=20002
EMBEDDING_BABYSITTER_PORT=20003

CACHE_TYPE_ROUTING_THRESHOLD=51200

WORKER_9G_API_PORT=8102
WORKER_9G_BABYSITTER_PORT=8103
WORKER_QWEN_API_PORT=8200
WORKER_QWEN_BABYSITTER_PORT=8201

MODEL1_DIR=/data-aisoft/zenghua/models/9g_8b_thinking_llama
QWEN3_32B_DIR=/data-aisoft/zenghua/models/Qwen3-32B
EMBEDDING_MODEL_DIR=/data-aisoft/zenghua/models/embedding-models
PIECEWISE_INDUCTOR_CACHE_DIR=../cache/piecewise_inductor

# Bench warehouse (frontend fragments + named volume). Optional:
#   ./compose.sh --profile frontend --profile warehouse-sync up -d
# BENCH_WAREHOUSE_GITHUB_TOKEN=ghp_xxx
# BENCH_WAREHOUSE_GIT_URL=https://github.com/InfiniTensor/bench-warehouse.git
# BENCH_WAREHOUSE_GIT_REF=master
# BENCH_WAREHOUSE_SYNC_INTERVAL_SEC=300
