## InfiniOrchestrator case: infinilm-metax-deployment-opt-20260325
##
## Copy to `.env` and edit:
##   cp .env.example .env
##
## Then run:
##   docker compose up -d
##

# Image built by ./container/metax/build-image.sh
IMAGE_TAG=infini-orchestrator-metax:local

# Ports (published from master). Defaults match docker-compose interpolation if omitted.
REGISTRY_PORT=18000
ROUTER_PORT=8000
EMBEDDING_PORT=20002

# Optional: size-based routing threshold for router (bytes)
CACHE_TYPE_ROUTING_THRESHOLD=51200

# When master GPU workers register, the registry stores http://<host>:<port>.
# Leave unset for single compose network (Docker DNS service names as defaults).
# Set to this host's LAN IP/hostname if the router on another machine must reach workers.
# MASTER_ADVERTISE_HOST=192.168.163.151

# Slave-only: point to master (required when slave stack is not in the same compose project).
# SLAVE_REGISTRY_URL=http://192.168.163.151:18000
# SLAVE_ROUTER_URL=http://192.168.163.151:8000
# Single-host compose (slave in same project as master) may use:
SLAVE_REGISTRY_URL=http://master:18000
SLAVE_ROUTER_URL=http://master:8000

# Slave-only: host/address stored in registry for OpenAI API URLs (must be reachable from master/router).
# Defaults to each service's Docker DNS name. On a remote slave host, set to that host's IP, e.g.:
# SLAVE_ADVERTISE_HOST=192.168.163.152

# Optional: host-published ports for slave workers (defaults match TOML inference + babysitter port+1).
# If FLA Qwen and 3vllm-1 run on one host, remap one preset, e.g. SLAVE_3VLLM_1_API_PORT=18200.
# SLAVE_FLA_9G_API_PORT=8100
# SLAVE_FLA_9G_BABYSITTER_PORT=8101
# SLAVE_FLA_QWEN_API_PORT=8200
# SLAVE_FLA_QWEN_BABYSITTER_PORT=8201
# SLAVE_3VLLM_1_API_PORT=8200
# SLAVE_3VLLM_1_BABYSITTER_PORT=8201
# SLAVE_3VLLM_2_API_PORT=8300
# SLAVE_3VLLM_2_BABYSITTER_PORT=8301

# Required model paths on the host
MODEL1_DIR=/path/to/9g_8b_thinking_llama
QWEN3_32B_DIR=/path/to/Qwen3-32B

# OOM handling: InferEngine.forward() logs (logger.error) then exits with code 137 on OOM-like exceptions (default).

# Optional: embedding/reranking models root directory.
# Expected subdirs:
#   - MiniCPM-Embedding-Light
#   - MiniCPM-Reranker-Light
#   - bce-reranker-base_v1
EMBEDDING_MODEL_DIR=/path/to/embedding-models
