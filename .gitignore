# Line-delimited JSON (benchmark datasets, probes, etc.) — do not commit
*.jsonl
**/*.jsonl

# Large offline bundles / docker saves
*.tar
*.tar.gz
*.tgz
**/offline-bundle-test/

# Bench / playground run artifacts
playground/Distribution/**/results/
playground/Standalone/**/results/
bench_results/

# Piecewise Inductor AOT seed products (keep README only)
playground/Distribution/**/piecewise_inductor_cache/**
!playground/Distribution/**/piecewise_inductor_cache/README.md
!playground/Distribution/**/piecewise_inductor_cache/.gitignore

# Distribution case host caches (AOT, etc.) — track only README / .gitignore
playground/Distribution/**/cache/**
!playground/Distribution/**/cache/**/
!playground/Distribution/**/cache/README.md
!playground/Distribution/**/cache/**/README.md
!playground/Distribution/**/cache/**/.gitignore

# Local env (templates *.example are tracked)
.env
.env.slave-sim
.image_tag

# Host-native warehouse sync runtime status (not warehouse content)
.warehouse-sync-status

# Rust / build
rust/target/
**/target/
