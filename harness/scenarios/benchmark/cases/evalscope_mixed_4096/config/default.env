# EvalScope mixed-batch 4096-token perf (issue #2 repro knobs).
MODEL="${MODEL:-Qwen3-32B}"
PARALLEL="${PARALLEL:-20}"
NUMBER="${NUMBER:-20}"
MIN_PROMPT_LENGTH="${MIN_PROMPT_LENGTH:-4096}"
MAX_PROMPT_LENGTH="${MAX_PROMPT_LENGTH:-4096}"
MIN_TOKENS="${MIN_TOKENS:-1024}"
MAX_TOKENS="${MAX_TOKENS:-1024}"
EVALSCOPE_API="${EVALSCOPE_API:-openai}"
EVALSCOPE_ENDPOINT="${EVALSCOPE_ENDPOINT:-/v1/chat/completions}"
EVALSCOPE_EXTRA_ARGS="${EVALSCOPE_EXTRA_ARGS:-{\"ignore_eos\": true}}"
ROUTER_READY_TIMEOUT_SEC="${ROUTER_READY_TIMEOUT_SEC:-3600}"
ROUTER_POLL_INTERVAL_SEC="${ROUTER_POLL_INTERVAL_SEC:-10}"
DEV_CONTAINER_NAME="${DEV_CONTAINER_NAME:-infinilm-dev-refactor-dev}"
EVALSCOPE_BIN="${EVALSCOPE_BIN:-evalscope}"
