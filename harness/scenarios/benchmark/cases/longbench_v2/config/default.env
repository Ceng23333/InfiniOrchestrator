# LongBench-v2 official 0-shot defaults (override via env).
LONGBENCH_LENGTH="${LONGBENCH_LENGTH:-short,medium}"
LONGBENCH_DIFFICULTY="${LONGBENCH_DIFFICULTY:-all}"
LIMIT="${LIMIT:-0}"
MAX_CONCURRENCY="${MAX_CONCURRENCY:-4}"
MAX_INPUT_TOKENS="${MAX_INPUT_TOKENS:-28672}"
TIMEOUT="${TIMEOUT:-600}"
ENABLE_THINKING="${ENABLE_THINKING:-${LONGBENCH_COT:-0}}"
MAX_GEN_TOKS="${MAX_GEN_TOKS:-128}"

# Dataset JSON lives under this case's cache/ (see cache/README.md).
if [[ -z "${LONGBENCH_DATA_JSON:-}" && -n "${CASE_ROOT:-}" && -f "${CASE_ROOT}/cache/data.json" ]]; then
  LONGBENCH_DATA_JSON="${CASE_ROOT}/cache/data.json"
fi
export LONGBENCH_DATA_JSON="${LONGBENCH_DATA_JSON:-}"
