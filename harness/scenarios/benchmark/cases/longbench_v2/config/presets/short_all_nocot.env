# LongBench-v2: short + all + official 0-shot (no CoT; ENABLE_THINKING=0).
# MAX_GEN_TOKS stays 128 (no CoT promote).
# Campaign overrides MAX_INPUT_TOKENS (e.g. main L0 → 28672); default is uncapped deploy baseline.
LONGBENCH_LENGTH="${LONGBENCH_LENGTH:-short}"
LONGBENCH_DIFFICULTY="${LONGBENCH_DIFFICULTY:-all}"
LIMIT="${LIMIT:-0}"
MAX_CONCURRENCY="${MAX_CONCURRENCY:-16}"
MAX_INPUT_TOKENS="${MAX_INPUT_TOKENS:-65408}"
TIMEOUT="${TIMEOUT:-600}"
ENABLE_THINKING="${ENABLE_THINKING:-0}"
MAX_GEN_TOKS="${MAX_GEN_TOKS:-128}"
# Dataset path comes from config/default.env → cache/data.json
