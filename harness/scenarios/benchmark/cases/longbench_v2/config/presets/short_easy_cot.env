# Minimal LongBench-v2 gate with official CoT: short + easy + ENABLE_THINKING=1.
# Harness promotes MAX_GEN_TOKS 128 → 2048 when thinking=1 (CoT phase uses 1024 in client).
LONGBENCH_LENGTH="${LONGBENCH_LENGTH:-short}"
LONGBENCH_DIFFICULTY="${LONGBENCH_DIFFICULTY:-easy}"
LIMIT="${LIMIT:-0}"
MAX_CONCURRENCY="${MAX_CONCURRENCY:-4}"
# Dual-backend QY baseline: ~8k input (match proven noCoT); serve stays 16384 for CoT gen headroom.
MAX_INPUT_TOKENS="${MAX_INPUT_TOKENS:-7800}"
TIMEOUT="${TIMEOUT:-600}"
ENABLE_THINKING="${ENABLE_THINKING:-1}"
MAX_GEN_TOKS="${MAX_GEN_TOKS:-128}"
# Official CoT phase gen budget (client reads LONGBENCH_COT_MAX_GEN; default 1024).
LONGBENCH_COT_MAX_GEN="${LONGBENCH_COT_MAX_GEN:-1024}"
# Dataset path comes from config/default.env → cache/data.json
