## InfiniOrchestrator case: infinilm-metax-deployment-opt-20260611
##
## Remote master deploy: see OFFLINE_DEPLOY_GUIDE_ZH_CN.md section 1 (step 3).
## Set MASTER_IP to this host's LAN IP (ip addr); SLAVE_ADVERTISE_HOST should match on same-host compose.
##

# Image built by ../../container/metax/build-image.sh
# Format: infini-orchestrator-metax:<IL_SHA>-<IC_SHA>-<BUILD_TS>
IMAGE_TAG=infini-orchestrator-metax:ece9948-8c901136-20260612

REGISTRY_PORT=18000
ROUTER_PORT=8000
EMBEDDING_PORT=20002
CACHE_TYPE_ROUTING_THRESHOLD=51200

# Same compose project: slave reaches master via Docker DNS
SLAVE_REGISTRY_URL=http://master:18000
SLAVE_ROUTER_URL=http://master:8000
# LAN IP of this host (validate.sh arg); e.g. 192.168.163.151 on remote master
SLAVE_ADVERTISE_HOST=192.168.163.151
SLAVE_XIYAN_API_PORT=8300
SLAVE_XIYAN_BABYSITTER_PORT=8301

# Remote master example paths (adjust per host)
MODEL1_DIR=/root/zenghua/models/9g_8b_thinking_llama
QWEN3_32B_DIR=/root/zenghua/models/Qwen3-32B
XIYAN_QWENCODER_DIR=/data-aisoft/zenghua/models/XGenerationLab/XiYanSQL-QwenCoder-32B-2504
EMBEDDING_MODEL_DIR=/root/zenghua/models

# Two-host slave on 192.168.163.152 (master on 151) — see OFFLINE_DEPLOY_GUIDE §3
