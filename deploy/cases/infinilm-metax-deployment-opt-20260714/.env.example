## InfiniOrchestrator case: infinilm-metax-deployment-opt-20260714
##
## Two-host (recommended): use split templates — only IP placeholders inside:
##   Master: cp .env.master.example .env
##   Slave:  cp .env.slave.example .env   # edit <MASTER_IP> / <SLAVE_IP>
##
## Single-host compose (master + slave same docker-compose project):
##   cp .env.example .env && edit model paths + IMAGE_TAG
##

IMAGE_TAG=infinilm-svc:metax-hpcc-ai370-PLACEHOLDER
# Optional: pin embeddings to 0611-era image (transformers 4.51) if IMAGE_TAG is TF5
# EMBEDDING_IMAGE_TAG=infini-orchestrator-metax:9647f70-b81c5860-20260701

REGISTRY_PORT=18000
ROUTER_PORT=8800
EMBEDDING_PORT=20003

CACHE_TYPE_ROUTING_THRESHOLD=51200

MASTER_9G_8B_THINKING_API_PORT=8102
MASTER_9G_8B_THINKING_BABYSITTER_PORT=8103
MASTER_QWEN_PAGED_API_PORT=8200
MASTER_QWEN_PAGED_BABYSITTER_PORT=8201

# Single-host compose only (slave in same project as master):
SLAVE_REGISTRY_URL=http://master:18000
SLAVE_ROUTER_URL=http://master:8800

MODEL1_DIR=/data-aisoft/zenghua/models/9g_8b_thinking_llama
QWEN3_32B_DIR=/data-aisoft/zenghua/models/Qwen3-32B
XIYAN_QWENCODER_DIR=/data-aisoft/zenghua/models/XGenerationLab/XiYanSQL-QwenCoder-32B-2504
EMBEDDING_MODEL_DIR=/data-aisoft/zenghua/models/embedding-models
PIECEWISE_INDUCTOR_CACHE_DIR=./piecewise_inductor_cache
