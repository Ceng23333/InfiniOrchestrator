## InfiniOrchestrator case: infinilm-metax-deployment-opt-20260325
##
## Copy to `.env` and edit:
##   cp .env.example .env
##
## Then run:
##   docker compose up -d
##

# Image built by ./container/metax/build-image.sh
IMAGE_TAG=infini-orchestrator-metax:local

# Ports (published from master)
REGISTRY_PORT=18000
ROUTER_PORT=8000
EMBEDDING_PORT=20002

# Optional: size-based routing threshold for router (bytes)
CACHE_TYPE_ROUTING_THRESHOLD=51200

# Required for slave workers: point to master host URLs.
# If master runs on another host, set it to that host IP.
SLAVE_REGISTRY_URL=http://192.168.163.151:18000
SLAVE_ROUTER_URL=http://192.168.163.151:8000

# Required model paths on the host
MODEL1_DIR=/root/zenghua/models/9g_8b_thinking_llama
QWEN3_32B_DIR=/root/zenghua/models/Qwen3-32B
EMBEDDING_MODEL_DIR=/root/zenghua/models
